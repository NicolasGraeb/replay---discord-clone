# Skopiuj do pliku .env i dostosuj w razie potrzeby.
# Async SQLAlchemy wymaga sterownika asyncpg w URL:
DATABASE_URL=postgresql+asyncpg://postgres:admin@127.0.0.1:9232/postgres

JWT_SECRET_KEY=zamien-na-dlugi-losowy-ciag-znakow-produkcyjnie
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO (obrazki w czacie) — zgodnie z docker-compose (bucket relay-images).
# Jeśli nic nie ustawisz, backend i tak użyje http://127.0.0.1:9000 (poza MINIO_DISABLED=1).
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=relay-images
# URL widoczny w przeglądarce (img src); zwykle jak MINIO_ENDPOINT
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# Maks. dłuższy bok po kompresji (px)
IMAGE_MAX_EDGE=1920
# MINIO_DISABLED=1
# CHAT_IMAGE_URL_EXPIRE_SECONDS=604800
